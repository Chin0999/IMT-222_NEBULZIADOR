#define BLYNK_TEMPLATE_ID "TMPL2OnHsJXNC"
#define BLYNK_TEMPLATE_NAME "Nebulizador"
#define BLYNK_AUTH_TOKEN "jVPZlWFU955gJl08RoqVdf0mOcJEdL4w"

#include <WiFi.h>
#include <BlynkSimpleEsp32.h>

// Tu WiFi
char ssid[] = "Central";
char pass[] = "f3**w12ex*p8d4mg*uimt+bgc";

// Variables compartidas y externas
extern bool humidificadorActivo;
extern bool nebulizandoActivo;

// -------------------------
// Control por Blynk
// -------------------------

// Botón virtual V0 → Prende/Apaga HUMIDIFICADOR
BLYNK_WRITE(V0) {
  int estado = param.asInt();  // 1 ON, 0 OFF

  if (estado == 1) {
    humidificadorActivo = true;
    estadoActual = ESTADO_NEBULIZANDO;
    iniciarNebulizacion();
    mostrarPantallaNebulizando();
    Blynk.virtualWrite(V2, "Nebulizando...");
  } else {
    humidificadorActivo = false;
    detenerNebulizacion();
    estadoActual = ESTADO_INICIO;
    mostrarPantallaInicial();
    Blynk.virtualWrite(V2, "Apagado");
  }
}

// Botón virtual V1 → Prende/Apaga VENTILADOR SOLO
BLYNK_WRITE(V1) {
  int estado = param.asInt();

  if (estado == 1) {
    digitalWrite(PIN_VENTILADOR, HIGH);
  } else {
    digitalWrite(PIN_VENTILADOR, LOW);
  }
}

void setup() {
  inicializarHardware();
  mostrarPantallaInicial();

  // Inicia Blynk
  Blynk.begin(BLYNK_AUTH_TOKEN, ssid, pass);
}

void loop() {
  Blynk.run();

  // Watchdog de pantalla OLED
  if (!oledOK()) reiniciarOLED();

  leerBoton();
  controlarFSM();
  actualizarAlarma();
  animacionWarning();
}



